BROKER SCHEMA com.poc.esqlstmt.basicf

CREATE FILTER MODULE Statement_Stmt_Return_MF_ReturnStmtTest
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE rootRef REFERENCE TO Root.JSON.Data.ReturnStmtRequest;
		IF UPPER(CAST(rootRef.Flag AS CHARACTER)) = 'FASLE' THEN
			RETURN FALSE;
		ELSEIF UPPER(CAST(rootRef.Flag AS CHARACTER)) = 'TRUE' THEN
			RETURN TRUE;
		ELSE
			RETURN UNKNOWN;
		END IF;
		RETURN TRUE;
	END;
END MODULE;
